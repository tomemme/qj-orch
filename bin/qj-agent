#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/qj-herdr.sh"

usage() {
  cat <<'EOF'
Usage:
  qj-agent plan  <project-name> [--from <url>] <loose-idea>
  qj-agent start <project-name> [--from <url>] [--map <url>] <mission> [flags]

Options:
  --from <url>    Clone the project from a remote URL (plan or start)
  --map  <url>    Link a wayfinder map into QJ_TASK.md (start only)
  --no-agents     Don't launch Claude/Codex; just open panes at the worktrees
  --no-dispatch   Launch the agents but don't send them the mission (leave idle)
  --safe          Don't pre-trust the worktree / don't relax Codex's sandbox;
                  agents get Claude/Codex's normal first-run prompts

Examples:
  qj-agent plan  my-app build a task manager with collaboration
  qj-agent plan  my-app --from git@github.com:user/app.git rethink the API
  qj-agent start my-app --map https://github.com/user/app/issues/1 implement JWT auth
  qj-agent start my-app fix login page
  qj-agent start my-app --no-dispatch overhaul the parser

Notes:
  - Requires a running herdr server. Start one with `herdr` (or run `qj-desk`).
  - If the project doesn't exist, plan/start creates it (git init, or clone with --from).
  - Each project gets its own herdr workspace:
      plan  -> workspace qj-plan-<project>  (Claude wayfinding session)
      start -> workspace qj-<project>       (merge pane + Claude/Codex worktree panes)
  - By default the agents are launched AND handed the mission immediately. Because
    qj-agent creates the worktree and writes QJ_TASK.md itself, it also marks that
    folder trusted for Claude (skips the "trust this folder?" dialog only) and starts
    Codex with --sandbox workspace-write. Per-command approvals still apply.
    Use --safe to skip all of that, --no-dispatch to launch idle.
EOF
}

# --- parse arguments -------------------------------------------------------
ACTION="${1:-}"
PROJECT="${2:-}"
FROM_URL=""
MAP_URL=""
NO_AGENTS=0
NO_DISPATCH=0
SAFE=0
MISSION_ARGS=()

if [[ -z "$ACTION" || -z "$PROJECT" ]]; then
  usage
  exit 1
fi
shift 2

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      [[ -n "${2:-}" ]] || die "--from requires a URL"
      FROM_URL="$2"; shift 2 ;;
    --map)
      [[ -n "${2:-}" ]] || die "--map requires a URL"
      MAP_URL="$2"; shift 2 ;;
    --no-agents)
      NO_AGENTS=1; shift ;;
    --no-dispatch|--idle)
      NO_DISPATCH=1; shift ;;
    --safe)
      SAFE=1; shift ;;
    --dispatch)
      shift ;;  # now the default; accepted as a no-op
    *)
      MISSION_ARGS+=("$1"); shift ;;
  esac
done

MISSION="${MISSION_ARGS[*]}"

case "$ACTION" in
  plan|start) ;;
  *) usage; exit 1 ;;
esac
[[ -n "$MISSION" ]] || { usage; exit 1; }
[[ "$ACTION" == "start" || -z "$MAP_URL" ]] || die "--map is only supported with 'start'"

qj_need herdr jq git
qj_require_herdr
(( NO_AGENTS )) || qj_warn_integrations claude codex

REPO="$PROJECTS_DIR/$PROJECT"
CODEX_WT="$WORK_DIR/$PROJECT-codex"
CLAUDE_WT="$WORK_DIR/$PROJECT-claude"

mkdir -p "$PROJECTS_DIR" "$WORK_DIR"

# --- ensure the project repo exists --------------------------------------
if [[ ! -d "$REPO" ]]; then
  if [[ -n "$FROM_URL" ]]; then
    echo "Cloning from $FROM_URL..."
    git clone "$FROM_URL" "$REPO"
  else
    echo "Creating new project: $REPO"
    mkdir -p "$REPO"
    git -C "$REPO" init
    echo "# $PROJECT" > "$REPO/README.md"
    git -C "$REPO" add README.md
    git -C "$REPO" commit -m "Initial commit"
  fi
elif [[ ! -d "$REPO/.git" ]]; then
  if [[ -n "$FROM_URL" ]]; then
    die "$REPO already exists — remove it first to clone from a URL"
  fi
  echo "Initializing git in existing folder: $REPO"
  git -C "$REPO" init
  git -C "$REPO" add -A
  git -C "$REPO" commit -m "Initial commit" --allow-empty
fi

cd "$REPO"

# Refresh the source remote only. Deployment remotes (Heroku, etc.) may need
# separate credentials and must not block opening a workspace.
if git remote get-url origin >/dev/null 2>&1; then
  git fetch origin --prune || true
fi

# ========================================================================
# plan -- lightweight Claude wayfinding session, no worktrees
# ========================================================================
if [[ "$ACTION" == "plan" ]]; then
  LABEL="qj-plan-$PROJECT"

  if [[ -n "$(qj_ws_id "$LABEL")" ]]; then
    echo "Plan workspace already exists: $LABEL"
    echo "Focus it in herdr, or run: qj-clean $PROJECT"
    exit 0
  fi

  # Record the idea in the notebook's Active Maps section.
  qj_ensure_notebook
  if ! grep -q "\- \[$PROJECT\]" "$NOTEBOOK"; then
    sed -i "/^## Active Maps/a - [$PROJECT] $MISSION" "$NOTEBOOK" 2>/dev/null || true
  fi

  read -r WS ROOT < <(qj_ws_create "$LABEL" "$REPO")

  qj_run "$ROOT" "clear && printf '\n  WAYFINDER: %s\n  Idea: %s\n\n  Run /wayfinder to chart the map.\n  Skills: /grilling /domain-modeling /research /prototype\n\n  When the map is clear:\n    qj-agent start %s --map <map-url> <mission>\n\n' '$PROJECT' '$MISSION' '$PROJECT'"

  if (( ! NO_AGENTS )); then
    (( SAFE )) || qj_trust_claude_dir "$REPO"
    PANE_WF=$(qj_split "$ROOT" right "$REPO")
    qj_agent_start "wf-$PROJECT" claude "$PANE_WF"
    if (( ! NO_DISPATCH )); then
      echo "Dispatching /wayfinder to the wayfinding agent..."
      qj_dispatch "wf-$PROJECT" "/wayfinder $MISSION"
    fi
  fi

  qj_ws_focus "$WS"
  echo "Wayfinding workspace ready: $LABEL"
  exit 0
fi

# ========================================================================
# start -- full implementation session with isolated worktrees
# ========================================================================
LABEL="qj-$PROJECT"

if [[ -n "$(qj_ws_id "$LABEL")" ]]; then
  WS="$(qj_ws_id "$LABEL")"
  qj_ws_focus "$WS"
  echo "Workspace already exists: $LABEL (focused)"
  exit 0
fi

# Isolated branches / worktrees.
[[ -d "$CODEX_WT"  ]] || git worktree add -b "qj/codex-$PROJECT"  "$CODEX_WT"
[[ -d "$CLAUDE_WT" ]] || git worktree add -b "qj/claude-$PROJECT" "$CLAUDE_WT"

# Render QJ_TASK.md into each worktree from the template.
MAP_DISPLAY="${MAP_URL:-_No map linked. Run qj-agent plan first for complex work._}"
for WT in "$CODEX_WT" "$CLAUDE_WT"; do
  while IFS= read -r LINE || [[ -n "$LINE" ]]; do
    case "$LINE" in
      '{{MISSION}}') printf '%s\n' "$MISSION" ;;
      '{{PROJECT}}') printf '%s\n' "$PROJECT" ;;
      '{{MAP_URL}}') printf '%s\n' "$MAP_DISPLAY" ;;
      *)             printf '%s\n' "$LINE" ;;
    esac
  done < "$TEMPLATE" > "$WT/QJ_TASK.md"
done

read -r WS ROOT < <(qj_ws_create "$LABEL" "$REPO")

# Pane 1: main repo / merge authority
qj_run "$ROOT" "clear && git status && echo && sed -n '1,12p' '$CLAUDE_WT/QJ_TASK.md' && echo && echo 'main repo / merge authority'"

# Pane 2: Claude worktree   Pane 3: Codex worktree
PANE_CLAUDE=$(qj_split "$ROOT" right "$CLAUDE_WT")
PANE_CODEX=$(qj_split "$PANE_CLAUDE" down "$CODEX_WT")

if (( NO_AGENTS )); then
  qj_run "$PANE_CLAUDE" "clear && cat QJ_TASK.md && echo && echo 'Start Claude with: claude'"
  qj_run "$PANE_CODEX"  "clear && cat QJ_TASK.md && echo && echo 'Start Codex with: codex'"
else
  if (( ! SAFE )); then
    qj_trust_claude_dir "$CLAUDE_WT" "$REPO"
    qj_trust_codex_repo "$REPO"
    CODEX_ARGS=(--sandbox workspace-write)
  else
    CODEX_ARGS=()
  fi
  qj_agent_start "claude-$PROJECT" claude "$PANE_CLAUDE"
  qj_agent_start "codex-$PROJECT"  codex  "$PANE_CODEX" "${CODEX_ARGS[@]}"
  if (( ! NO_DISPATCH )); then
    echo "Dispatching mission to agents..."
    qj_dispatch "claude-$PROJECT" "$MISSION"
    qj_dispatch "codex-$PROJECT"  "$MISSION"
  fi
fi

qj_ws_focus "$WS"
echo "Ready: workspace $LABEL"
echo "  main:   $REPO"
echo "  claude: $CLAUDE_WT   (branch qj/claude-$PROJECT)"
echo "  codex:  $CODEX_WT   (branch qj/codex-$PROJECT)"
