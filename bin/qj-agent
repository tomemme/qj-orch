#!/usr/bin/env bash
set -euo pipefail

PROJECTS_DIR="$HOME/ai-projects"
AI_WORK_DIR="$HOME/ai-work"
ORCH_DIR="$HOME/qj-orch"
TEMPLATE="$ORCH_DIR/templates/QJ_TASK.md"

usage() {
  echo "Usage:"
  echo "  qj-agent plan  <project-name> <loose-idea>"
  echo "  qj-agent plan  <project-name> --from <url> <loose-idea>"
  echo "  qj-agent start <project-name> <mission>"
  echo "  qj-agent start <project-name> --from <url> <mission>"
  echo "  qj-agent start <project-name> --map <url> <mission>"
  echo "  qj-agent add   <project-name> <mission>"
  echo
  echo "Options:"
  echo "  --from <url>  Clone from a remote URL (plan or start)"
  echo "  --map <url>   Link to a wayfinder map (start only)"
  echo
  echo "Examples:"
  echo "  qj-agent plan my-app build a task manager with collaboration"
  echo "  qj-agent plan my-app --from git@github.com:user/app.git rethink the API"
  echo "  qj-agent start my-app --map https://github.com/user/app/issues/1 implement JWT auth"
  echo "  qj-agent start my-app fix login page"
  echo "  qj-agent add active-waybar-calendar fix hover wrap"
  echo
  echo "If the project doesn't exist, 'plan' or 'start' will create it automatically."
  echo
  echo "Workflow:"
  echo "  plan  → Wayfinder session to chart the map (unclear ideas)"
  echo "  start → Full implementation session (clear missions)"
}

# Parse arguments
ACTION="${1:-}"
PROJECT="${2:-}"
FROM_URL=""
MAP_URL=""
MISSION_ARGS=()

if [[ -z "$ACTION" ]] || [[ -z "$PROJECT" ]]; then
  usage
  exit 1
fi

shift 2

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --from requires a URL"
        exit 1
      fi
      FROM_URL="$2"
      shift 2
      ;;
    --map)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --map requires a URL"
        exit 1
      fi
      MAP_URL="$2"
      shift 2
      ;;
    *)
      MISSION_ARGS+=("$1")
      shift
      ;;
  esac
done

MISSION="${MISSION_ARGS[*]}"

if { [[ "$ACTION" != "start" ]] && [[ "$ACTION" != "add" ]] && [[ "$ACTION" != "plan" ]]; } || [[ -z "$MISSION" ]]; then
  usage
  exit 1
fi

if [[ "$ACTION" == "add" ]] && [[ -n "$FROM_URL" ]]; then
  echo "Error: --from is only supported with 'plan' or 'start', not 'add'"
  exit 1
fi

if [[ "$ACTION" == "add" ]] && [[ -n "$MAP_URL" ]]; then
  echo "Error: --map is only supported with 'start', not 'add'"
  exit 1
fi

if [[ "$ACTION" == "plan" ]] && [[ -n "$MAP_URL" ]]; then
  echo "Error: --map is only supported with 'start', not 'plan'"
  exit 1
fi

REPO="$PROJECTS_DIR/$PROJECT"
CODEX_WT="$AI_WORK_DIR/$PROJECT-codex"
CLAUDE_WT="$AI_WORK_DIR/$PROJECT-claude"
SESSION="qj-$PROJECT"

# Ensure base directories exist
mkdir -p "$PROJECTS_DIR" "$AI_WORK_DIR"

# Auto-create or clone project if it doesn't exist
if [[ ! -d "$REPO" ]]; then
  if [[ -n "$FROM_URL" ]]; then
    echo "Cloning from $FROM_URL..."
    git clone "$FROM_URL" "$REPO"
  else
    echo "Creating new project: $REPO"
    mkdir -p "$REPO"
    git -C "$REPO" init
    echo "# $PROJECT" > "$REPO/README.md"
    git -C "$REPO" add README.md
    git -C "$REPO" commit -m "Initial commit"
  fi
elif [[ ! -d "$REPO/.git" ]]; then
  # Folder exists but no git
  if [[ -n "$FROM_URL" ]]; then
    echo "Error: $REPO already exists. Remove it first to clone from URL."
    exit 1
  else
    echo "Initializing git in existing folder: $REPO"
    git -C "$REPO" init
    git -C "$REPO" add -A
    git -C "$REPO" commit -m "Initial commit" --allow-empty
  fi
fi

cd "$REPO"

# Only update the source remote. Deployment remotes such as Heroku may require
# separate credentials and should not block or prompt while opening a workspace.
if git remote get-url origin >/dev/null 2>&1; then
  git fetch origin --prune || true
fi

# Handle plan action - lightweight wayfinding session (no worktrees needed)
if [[ "$ACTION" == "plan" ]]; then
  SESSION="qj-plan-$PROJECT"

  tmux has-session -t "$SESSION" 2>/dev/null && {
    echo "Plan session already exists. Attach with:"
    echo "  tmux attach -t $SESSION"
    exit 0
  }

  # Update notebook with new planning session
  NOTEBOOK="$ORCH_DIR/notebook.md"
  if [[ -f "$NOTEBOOK" ]]; then
    # Add to Active Maps section if not already there
    if ! grep -q "- \[$PROJECT\]" "$NOTEBOOK"; then
      sed -i "/^## Active Maps/a - [$PROJECT] $MISSION" "$NOTEBOOK" 2>/dev/null || true
    fi
  fi

  # Create lightweight 2-pane layout for wayfinding
  PANE_CLAUDE=$(tmux new-session -d -s "$SESSION" -n "wayfind" -c "$REPO" -P -F "#{pane_id}")

  # Pane 1: Claude wayfinding session
  tmux send-keys -t "$PANE_CLAUDE" "clear && echo -e '\n  WAYFINDER SESSION: $PROJECT\n  Idea: $MISSION\n\n  Run: /wayfinder to chart the map\n  Skills: /grilling /domain-modeling /research /prototype\n\n  When the map is clear, exit and run:\n    qj-agent start $PROJECT --map <map-url> <mission>\n'" C-m

  # Pane 2: Notes pane for tracking
  PANE_NOTES=$(tmux split-window -h -t "$PANE_CLAUDE" -c "$REPO" -P -F "#{pane_id}" -l 40%)
  tmux send-keys -t "$PANE_NOTES" "clear && echo -e 'Notes pane - track decisions here\n\nIdea: $MISSION\n'" C-m

  # Focus on Claude pane
  tmux select-pane -t "$PANE_CLAUDE"

  echo "Wayfinding session ready. Attach with:"
  echo "  tmux attach -t $SESSION"
  echo
  echo "In the session, run /wayfinder to chart your idea."
  exit 0
fi

# --- Implementation phase (start/add) ---

# Create isolated branches/worktrees if they do not already exist.
if [[ ! -d "$CODEX_WT" ]]; then
  git worktree add -b "qj/codex-$PROJECT" "$CODEX_WT"
fi

if [[ ! -d "$CLAUDE_WT" ]]; then
  git worktree add -b "qj/claude-$PROJECT" "$CLAUDE_WT"
fi

# Create task files.
MAP_DISPLAY="${MAP_URL:-_No map linked. Run qj-agent plan first for complex work._}"
for WT in "$CODEX_WT" "$CLAUDE_WT"; do
  while IFS= read -r LINE || [[ -n "$LINE" ]]; do
    case "$LINE" in
      '{{MISSION}}') printf '%s\n' "$MISSION" ;;
      '{{PROJECT}}') printf '%s\n' "$PROJECT" ;;
      '{{MAP_URL}}') printf '%s\n' "$MAP_DISPLAY" ;;
      *) printf '%s\n' "$LINE" ;;
    esac
  done < "$TEMPLATE" > "$WT/QJ_TASK.md"
done

# Start tmux layout.
if [[ "$ACTION" == "add" ]]; then
  DESK_SESSION="qj-desk"

  if ! tmux has-session -t "$DESK_SESSION" 2>/dev/null; then
    echo "qj-desk is not running. Start it first with:"
    echo "  qj-desk"
    exit 1
  fi

  WINDOW="$PROJECT"

  if tmux list-windows -t "$DESK_SESSION" -F "#{window_name}" | grep -qx "$WINDOW"; then
    echo "Window already exists in qj-desk: $WINDOW"
    echo "Attach with:"
    echo "  tmux attach -t qj-desk"
    exit 0
  fi

  PANE_MAIN=$(tmux new-window -t "$DESK_SESSION" -n "$WINDOW" -c "$REPO" -P -F "#{pane_id}")

else
  tmux has-session -t "$SESSION" 2>/dev/null && {
    echo "Session already exists. Attach with:"
    echo "tmux attach -t $SESSION"
    exit 0
  }

  WINDOW="qj"
  PANE_MAIN=$(tmux new-session -d -s "$SESSION" -n "$WINDOW" -c "$REPO" -P -F "#{pane_id}")
fi

# Pane 1: main repo / merge authority
tmux send-keys -t "$PANE_MAIN" "cd '$REPO' && clear && git status && echo 'Main repo / merge authority'" C-m

# Pane 2: Codex worktree
PANE_CODEX=$(tmux split-window -h -t "$PANE_MAIN" -c "$CODEX_WT" -P -F "#{pane_id}")
tmux send-keys -t "$PANE_CODEX" "cd '$CODEX_WT' && clear && echo 'Codex worktree' && cat QJ_TASK.md && echo && echo 'Start Codex with: codex'" C-m

# Pane 3: Claude worktree
PANE_CLAUDE=$(tmux split-window -v -t "$PANE_CODEX" -c "$CLAUDE_WT" -P -F "#{pane_id}")
tmux send-keys -t "$PANE_CLAUDE" "cd '$CLAUDE_WT' && clear && echo 'Claude worktree' && cat QJ_TASK.md && echo && echo 'Start Claude with: claude'" C-m

# Pane 4: tests/server pane
PANE_TESTS=$(tmux split-window -v -t "$PANE_MAIN" -c "$REPO" -P -F "#{pane_id}")
tmux send-keys -t "$PANE_TESTS" "cd '$REPO' && clear && echo 'Tests/server pane. Run your dev server or tests here.'" C-m

# Pane 5: local notes/checklist
PANE_NOTES=$(tmux split-window -v -t "$PANE_TESTS" -c "$REPO" -P -F "#{pane_id}")
tmux send-keys -t "$PANE_NOTES" "cd '$REPO' && clear && nvim QJ_TASK.md" C-m

if [[ "$ACTION" == "add" ]]; then
  tmux select-layout -t "$DESK_SESSION:$WINDOW" tiled
  echo "Added project window to qj-desk:"
  echo "  $PROJECT"
  echo
  echo "Attach with:"
  echo "  tmux attach -t qj-desk"
else
  tmux select-layout -t "$SESSION:$WINDOW" tiled
  echo "Ready. Attach with:"
  echo "  tmux attach -t $SESSION"
fi
