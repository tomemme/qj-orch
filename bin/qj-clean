#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/qj-herdr.sh"

PROJECT="${1:-}"
[[ -n "$PROJECT" ]] || die "Usage: qj-clean <project>"

qj_need git

REPO="$PROJECTS_DIR/$PROJECT"
CODEX_WT="$WORK_DIR/$PROJECT-codex"
CLAUDE_WT="$WORK_DIR/$PROJECT-claude"

[[ -d "$REPO/.git" ]] || die "no git repo at $REPO"
cd "$REPO"

echo "Main repo status:"
git status
echo

read -rp "Remove Codex worktree and branch? [y/N] " ans
if [[ "$ans" =~ ^[Yy]$ ]]; then
  git worktree remove --force "$CODEX_WT" 2>/dev/null || true
  git branch -D "qj/codex-$PROJECT" 2>/dev/null || true
fi

read -rp "Remove Claude worktree and branch? [y/N] " ans
if [[ "$ans" =~ ^[Yy]$ ]]; then
  git worktree remove --force "$CLAUDE_WT" 2>/dev/null || true
  git branch -D "qj/claude-$PROJECT" 2>/dev/null || true
fi

# Close the herdr workspaces (agents die with their panes). Best-effort, and
# only if a server is reachable -- worktree cleanup above works offline.
if qj_herdr_up; then
  for label in "qj-$PROJECT" "qj-plan-$PROJECT"; do
    id="$(qj_ws_id "$label")"
    if [[ -n "$id" ]]; then
      read -rp "Close herdr workspace '$label'? [y/N] " ans
      [[ "$ans" =~ ^[Yy]$ ]] && qj_ws_close "$id"
    fi
  done
fi

echo "Done."
