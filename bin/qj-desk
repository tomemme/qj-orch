#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/qj-herdr.sh"

qj_need herdr

# Personal notebook for ideas, decisions, and follow-ups.
qj_ensure_notebook

# No herdr server yet -> launch one. Re-run `qj-desk` from inside it to open
# the notebook workspace.
if ! qj_herdr_up; then
  echo "Starting herdr... run 'qj-desk' again inside it to open the notebook."
  exec herdr
fi

qj_need jq nvim

WS="$(qj_ws_id qj-desk)"
if [[ -n "$WS" ]]; then
  qj_ws_focus "$WS"
  echo "Focused workspace: qj-desk"
else
  read -r WS ROOT < <(qj_ws_create qj-desk "$ORCH_DIR")
  qj_run "$ROOT" "nvim '$NOTEBOOK'"
  qj_ws_focus "$WS"
  echo "Opened workspace: qj-desk ($NOTEBOOK)"
fi
